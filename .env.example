# ============ Stland-server 配置 ============
STLAND_HOST=0.0.0.0
STLAND_PORT=8999
STLAND_DB_URL=sqlite:///./data/stland.db

# 服务端密钥（生产环境务必替换为随机 64 位十六进制）
STLAND_JWT_SECRET=change-me-in-production-jwt
STLAND_SIGN_SECRET=change-me-in-production-sign
STLAND_ACCESS_TOKEN_TTL=7200
STLAND_CLOCK_SKEW=60

# 演示账户初始资金
STLAND_SEED_CASH=1000000

# 行情模拟参数（无外部数据源，全部内部生成）
STLAND_TICK_SECONDS=1
STLAND_FORCE_OPEN=false
